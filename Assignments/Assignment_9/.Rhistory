ibrary(dplyr)
grad_data = read.csv("GradSchool_Admissions.csv")
print(head(grad_data))
print(str(grad_data))
print(summary(grad_data))
print(sum(is.na(grad_data)))
# Load the necessary libraries
library(dplyr)
library(dplyr)
grad_data$admit <- factor(grad_data$admit,
levels = c(0, 1),
labels = c("Denied", "Admitted"))
# rank: 1="top-tier" to 4="lowest-tier" (ordinal, but treated as categorical in glm)
# R will automatically set the lowest numerical level (1) as the reference category.
grad_data$rank <- factor(grad_data$rank)
# Re-check the structure to confirm the changes
print(str(grad_data))
# Create a figure that shows the proportion of admitted versus denied students for each
# undergraduate institution rank.
ggplot(data, aes(x = rank, fill = admit)) +
geom_bar(position = "fill") +
scale_y_continuous(labels = scales::percent) +
labs(
title = "Admission Status by Undergraduate Institution Rank",
y = "Proportion",
x = "Undergraduate Institution Rank",
fill = "Admission Status"
) +
theme_minimal() +
scale_fill_manual(values = c("Denied" = "#F8766D", "Admitted" = "#00BFC4"))
