# 1. Read the dataset
dat = dat = read_csv("C:/Users/Angie/Desktop/Data_Course_BOLLARD/Data/BioLog_Plate_Data.csv")
# 2. Clean, transform, and summarize the data
biolog_data_summary <- dat %>%
filter(Substrate == "Itaconic Acid") %>%
filter(Dilution == 0.1) %>%
pivot_longer(
cols = starts_with("Hr_"),
names_to = "Time_point_Hr_String",
values_to = "Absorbance"
) %>%
mutate(
Sample_Type = ifelse(str_detect(`Sample ID`, "[Ss]oil"), "Soil", "Water"),
Time_point_Hr = parse_number(Time_point_Hr_String)
) %>%
group_by(Time_point_Hr, Sample_Type) %>%
summarise(
Mean_Absorbance = mean(Absorbance, na.rm = TRUE), # THIS IS CREATING THE COLUMN
.groups = 'drop'
)
# --- CRITICAL CHECK ---
# Verify if the column 'Mean_Absorbance' is in the data frame *right now*
if (!("Mean_Absorbance" %in% names(biolog_data_summary))) {
stop(
"FATAL ERROR: 'Mean_Absorbance' column does not exist in 'biolog_data_summary'.\n",
"This means your filters likely removed all rows from the dataset.\n",
"Please check your CSV file for values matching 'Itaconic Acid' AND '0.1' exactly."
)
} else {
print("Check passed: 'Mean_Absorbance' column found. Proceeding to plot.")
}
p <- ggplot(biolog_data_summary, aes(x = Time_point_Hr, y = Mean_Absorbance, color = Sample_Type)) +
geom_line(size = 1) +
geom_point(size = 3) +
labs(
title = 'Mean Absorbance of Itaconic Acid Samples over Time',
subtitle = 'Time Point (Hours): {frame_time}',
x = 'Time Point (Hours)',
y = 'Mean Absorbance',
color = 'Sample Type'
) +
theme_minimal() +
scale_color_manual(values = c("Soil" = "brown", "Water" = "blue")) +
transition_time(Time_point_Hr) +
ease_aes('linear') +
shadow_wake(wake_length = 0.1, alpha = FALSE)
animated_plot <- animate(p, fps = 10, duration = 10, width = 600, height = 400, renderer = gifski_renderer())
anim_save("animated_biolog_plot.gif", animated_plot)
p <- ggplot(biolog_data_summary, aes(x = Time_point_Hr, y = Mean_Absorbance, color = Sample_Type)) +
geom_line(size = 1.5) + # Thicker line for better visibility of growth
geom_point(size = 4, alpha = 0.7) + # Points for emphasis
labs(
title = 'Mean Absorbance of Itaconic Acid Samples over Time',
subtitle = 'Time Point (Hours): {frame_along} (Growing Line Animation)', # {frame_along} shows current X-value
x = 'Time Point (Hours)',
y = 'Mean Absorbance',
color = 'Sample Type'
) +
theme_minimal(base_size = 14) +
scale_color_manual(values = c("Soil" = "brown", "Water" = "blue")) +
# Use transition_reveal to grow the line along the X-axis (Time_point_Hr)
transition_reveal(along = Time_point_Hr) +
ease_aes('linear')
animated_plot <- animate(
p,
fps = 15,          # Frames per second
nframes = 45,      # Total frames (15fps * 3s total duration)
width = 700,
height = 450,
renderer = gifski_renderer()
)
anim_save("animated_biolog_growing_line_plot.gif", animated_plot)
# Define the specific Sample IDs we want to plot
selected_samples <- c("Clear_creek", "Soil_1", "Soil_2", "Waste_Water")
# Clean, transform, and summarize the data
biolog_data_summary <- biolog_data_raw %>%
# Filter for the specific substrate "Itaconic Acid"
filter(Substrate == "Itaconic Acid") %>%
# Filter for the specific dilution (assuming 0.1)
filter(Dilution == 0.1) %>%
# Filter ONLY for the specific Sample IDs requested
filter(`Sample ID` %in% selected_samples) %>%
# Pivot the time-point columns (Hr_24, Hr_48, Hr_144) into long format
pivot_longer(
cols = starts_with("Hr_"),
names_to = "Time_point_Hr_String",
values_to = "Absorbance"
) %>%
mutate(
# Convert Time_point string (e.g., "Hr_24") to a numeric value (e.g., 24)
Time_point_Hr = parse_number(Time_point_Hr_String),
# Ensure Sample ID is a factor for consistent plotting order
`Sample ID` = factor(`Sample ID`, levels = selected_samples)
) %>%
# Calculate the mean absorbance for all 3 replicates for each group
# Grouping by the specific ID now
group_by(Time_point_Hr, `Sample ID`) %>%
summarise(
Mean_Absorbance = mean(Absorbance, na.rm = TRUE),
.groups = 'drop'
)
