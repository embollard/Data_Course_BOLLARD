library(broom)
# Read in data set
dat = read.csv("C:/Users/Angie/Desktop/Data_Course_BOLLARD/Exam_2/unicef-u5mr.csv")
View(dat)
headers = colnames(dat)
print(headers)
# Put into tidy format
u5mr_tidy <- dat %>%
pivot_longer(
cols = starts_with("U5MR."),
names_to = "Year",
values_to = "U5MR"
) %>%
mutate(
Year = as.numeric(str_replace(Year, "U5MR.", "")),
# Ensure Continent is treated as a factor for modeling purposes
Continent = as.factor(Continent)
) %>%
# Filter out NAs which cause issues for linear models
filter(!is.na(U5MR), !is.na(Continent))
# --- Create the Three Models ---
# Model 1: U5MR accounted for only by Year (simple linear regression)
# Formula: U5MR ~ Year
mod1 <- lm(U5MR ~ Year, data = u5mr_tidy)
# Model 2: U5MR accounted for by Year and Continent (additive effects)
# Formula: U5MR ~ Year + Continent
mod2 <- lm(U5MR ~ Year + Continent, data = u5mr_tidy)
# Model 3: U5MR accounted for by Year, Continent, and their interaction
# Formula: U5MR ~ Year * Continent
mod3 <- lm(U5MR ~ Year * Continent, data = u5mr_tidy)
# List the models for easy iteration
models_list <- list(
"Model 1 (Year only)" = mod1,
"Model 2 (Year + Continent)" = mod2,
"Model 3 (Year * Continent)" = mod3
)
# --- Generate and Plot Each Model's Predictions Individually ---
# Create a base grid for predictions across all years and continents
prediction_data_base <- expand.grid(
Year = seq(min(u5mr_tidy$Year), max(u5mr_tidy$Year), by = 1),
Continent = unique(u5mr_tidy$Continent)
)
# Loop through each model
for (i in seq_along(models_list)) {
model_name <- names(models_list)[i]
current_model <- models_list[[i]]
# Calculate predictions for the current model
prediction_data <- prediction_data_base %>%
mutate(Prediction = predict(current_model, newdata = .))
# Create the plot
p = ggplot(u5mr_tidy, aes(x = Year, y = U5MR)) +
geom_point(alpha = 0.1, color = "gray") + # Actual data points
geom_line(data = prediction_data, aes(y = Prediction), color = "dodgerblue", size = 1.2) + # Model predictions
facet_wrap(~ Continent) +
labs(
title = paste("Predictions for:", model_name),
subtitle = "Actual data points in gray; Model fit shown in blue line",
x = "Year",
y = "U5MR (deaths per 1000 live births)"
) +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5))
print(p)
file_name = paste0("u5mr_plot_", gsub(" ", "_", tolower(model_name)), ".png")
ggsave(file_name, plot = p, width = 10, height = 7, units = "in", dpi = 300)
if (i < length(models_list)) {
Sys.sleep(1)
}
}
