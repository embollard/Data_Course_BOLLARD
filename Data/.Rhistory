assignInNamespace("frame_variables", function(nframes) {
nc <- ceiling(log10(nframes + 1))
frame <- seq_len(nframes)
tibble::tibble(frame, frame_lab = sprintf(paste0("%0", nc, "d"), frame))
}, ns = "gganimate")
unlockBinding("format_frame", asNamespace("gganimate"))
