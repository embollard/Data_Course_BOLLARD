clean_bird_data = function(dat %>% names()
clean_bird_data = function(dat){
dat %>% names()
#The categories that we want, excluding all other categories
iwant = c("Family", "Species_number", "Species_name", "English_name",
"Clutch_size", "Egg_mass", "Mating_System")
#Cleaned male Data
df_male = dat %>%
select(iwant, starts_with('M_'), -ends_with('_N')) %>%
mutate(sex = 'male') %>%
View()
#Cleaned female data
df_female = dat %>%
select(iwant, starts_with('F_'), -ends_with('_N')) %>%
mutate(sex = 'female') %>%
View()
#Cleaned unsexed data
df_unsex = dat %>%
select(iwant, starts_with('Unsexed_'), -ends_with('_N')) %>%
mutate(sex = 'unsexed') %>%
View()
# Joining cleaned male data and cleaned female data
ob1 = full_join(df_male, df_female)
ob2 = full_join(ob1, df_unsex)
return(df_male)
}
return(df_male)
