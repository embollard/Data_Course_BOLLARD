print(head(longevity_data))
longevity_data <- read_csv("longevity.csv")
print(head(longevity_data))
print(glimpse(longevity_data))
ggplot(longevity_data, aes(x = Association)) +
geom_bar(fill = "skyblue", color = "black") +
labs(
title = "Count of Studies by Association (Significant vs. Non-significant)",
x = "Association Type",
y = "Number of Studies"
) +
theme_minimal() +
# Rotate x-axis labels to be more readable
theme(axis.text.x = element_text(angle = 45, hjust = 1))
